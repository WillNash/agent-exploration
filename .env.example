DATABASE_URL=postgresql://garden:secret@localhost:5432/garden_store
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
AGENT_URL=http://localhost:8000/rpc

# Ollama settings for the LLM-powered executor
# Use http://host.docker.internal:11434 when running inside Docker/WSL
# Use http://localhost:11434 when running the backend directly on the host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:70b
